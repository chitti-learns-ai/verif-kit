{
  "name": "verif-kit",
  "version": "0.1.0",
  "description": "Independent, coverage-driven verification for any project — spec-kit for verification. A blind, fresh-context agent verifies your code from the spec alone.",
  "license": "MIT",
  "kind": "verification-engine",

  "commandSurface": {
    "agent": "agents/verification-engineer.md",
    "skill": "skills/verif-kit-verify/SKILL.md"
  },
  "templates": [
    "templates/verification-contract-template.md",
    "templates/vplan-template.md",
    "templates/verification-tasks-template.md"
  ],
  "frameworks": {
    "typescript": ["framework/typescript/scoreboard.ts", "framework/typescript/coverage-model.ts"]
  },
  "scripts": {
    "powershell": [
      "scripts/powershell/vk-common.ps1",
      "scripts/powershell/vk-check-prerequisites.ps1",
      "scripts/powershell/vk-setup-verification.ps1"
    ],
    "bash": [
      "scripts/bash/vk-common.sh",
      "scripts/bash/vk-check-prerequisites.sh",
      "scripts/bash/vk-setup-verification.sh"
    ]
  },
  "configExample": "verif-kit.config.example.json",
  "evidence": "validation/FINDINGS.md",
  "docs": ["docs/methodology.md", "docs/better-than-speckit.md", "README.md"],

  "install": {
    "installer": "install.mjs",
    "agentsTo": ".claude/agents",
    "skillsTo": ".claude/skills",
    "engineTo": ".verif-kit",
    "templatesTo": ".specify/templates (if spec-kit present) else .verif-kit/templates",
    "writesConfigIfAbsent": "verif-kit.config.json",
    "writesManifest": ".verif-kit/verif-kit.json (per-file sha256 for tamper/version tracking)"
  },
  "integration": {
    "specKit": {
      "afterImplementHook": "verif-kit.verify",
      "phaseZTask": true,
      "note": "see install.md — zero changes to spec-kit core; uses its hook scanner"
    }
  },
  "honestLimits": "Probabilistic (LLM-based, not a prover); shares spec blind spots with the author (mitigated by oracle-free checks, not eliminated); v1 ships a TypeScript framework pack only. Ships reproducible bug-injection evidence rather than a perfection claim."
}
